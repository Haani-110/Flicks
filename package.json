{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/make-sitemap.mjs",
    "prebuild": "node scripts/make-sitemap.mjs",
    "build": "vite build",
    "prebuild:split": "node scripts/make-sitemap.mjs",
    "build:split": "vite build --mode split",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "lint": "oxlint --deny-warnings .",
    "screenshots": "playwright test --config playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.101",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@react-three/fiber": "^9.7.0",
    "ai": "^6.0.280",
    "clsx": "2.1.1",
    "lucide-react": "^1.45.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "3.4.0",
    "three": "^0.186.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vercel/node": "^13.0.0",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.82.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^5.0.0"
  }
}
