# ---------------------------------------------------------------------------
# Flicks — environment template
#
# Copy to `.env.local` for local development (`cp .env.example .env.local`).
# On Vercel, set the server-side values under Project → Settings → Environment
# Variables. `.env*` files are gitignored; never commit a real key.
#
# Only variables prefixed with VITE_ are inlined into the browser bundle by
# Vite. Everything else stays on the server. That is deliberate: the model key
# must never reach the client, which is why the chat goes through `api/chat.ts`
# instead of calling OpenRouter from the browser.
# ---------------------------------------------------------------------------

# REQUIRED for the AI assistant (server-side, api/chat.ts).
# OpenRouter API key: https://openrouter.ai/settings/keys
# Without it, `POST /api/chat` answers 503 with a plain-language message and
# the rest of the app (browse, watchlist, marquee, health) keeps working.
OPENROUTER_API_KEY=

# OPTIONAL (server-side). Signing key for the short-lived chat tokens handed
# out by `GET /api/chat`. If unset, the key is derived from OPENROUTER_API_KEY,
# so the token check switches itself on wherever a real key is deployed. Set it
# explicitly only if you want to rotate tokens without rotating the model key.
CHAT_TOKEN_SECRET=

# OPTIONAL (client-side, inlined at build time). Upstream URL probed by the
# /health page's external dependency check. Left empty, that check is skipped
# and the page reports only the app's own state — no request is invented.
VITE_HEALTH_CHECK_API_URL=
